[Unit]
Description=GPD Pocket 3 first boot: replicate the Precision 5520 (setup-pocket3.sh)
After=network.target multi-user.target
Wants=network.target

[Service]
Type=simple
ExecStart=/home/adam/pocket3-payload/autoinstall/firstboot.sh
StandardOutput=append:/home/adam/setup-pocket3-firstboot.log
StandardError=append:/home/adam/setup-pocket3-firstboot.log
Restart=no

[Install]
WantedBy=multi-user.target
